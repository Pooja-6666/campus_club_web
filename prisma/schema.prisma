generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  student_id     Int             @id @default(autoincrement())
  name           String
  email          String          @unique
  password       String
  interests      String[]        @default([])
  bookmarks      Bookmark[]
  views          EventView[]
  rsvps          RSVP[]
  feedback       EventFeedback[]
  notInterested  NotInterested[]
  eventInterests EventInterest[]

  passwordResetOTP PasswordResetOTP?
}

model Organizer {
  org_id   Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String

  club_id Int
  club    Club @relation(fields: [club_id], references: [club_id])

  events Event[]

  passwordResetOTP OrganizerPasswordResetOTP?
}

model Faculty {
  faculty_id Int    @id @default(autoincrement())
  name       String
  email      String @unique
  password   String

  club_id Int
  club    Club @relation(fields: [club_id], references: [club_id])

  passwordResetOTP FacultyPasswordResetOTP?
}

model Admin {
  admin_id Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
}

model Club {
  club_id     Int     @id @default(autoincrement())
  club_name   String  @unique
  description String?

  // 👉 NEW fields added safely as optional (?) so existing clubs don't break
  department   String? // e.g., "Computer Science & Engineering"
  faculty_lead String? // Faculty coordinator name
  logo_url     String? // Club logo image path

  organizers Organizer[]
  events     Event[]
  faculty    Faculty[]
}

model Event {
  event_id        Int       @id @default(autoincrement())
  title           String
  description     String
  date            DateTime
  endDate         DateTime?
  time            String?
  venue           String
  contact_phone   String?
  registrationUrl String?
  status          String    @default("PENDING")
  rejectionReason String?
  category        String?
  tags            String[]  @default([])
  capacity        Int?
  posterUrl       String?
  extractedText   String?
  createdAt       DateTime  @default(now())

  club_id    Int
  club       Club      @relation(fields: [club_id], references: [club_id])
  created_by Int
  organizer  Organizer @relation(fields: [created_by], references: [org_id])

  promotions     EventPromotion[]
  bookmarks      Bookmark[]
  views          EventView[]
  rsvps          RSVP[]
  feedback       EventFeedback[]
  eventInterests EventInterest[]
  editRequests   EventEditRequest[]

  @@index([status])
  @@index([date])
  @@index([club_id])
  @@index([category])
}

model Bookmark {
  id         Int      @id @default(autoincrement())
  student_id Int
  event_id   Int
  createdAt  DateTime @default(now())

  student Student @relation(fields: [student_id], references: [student_id])
  event   Event   @relation(fields: [event_id], references: [event_id])

  @@unique([student_id, event_id])
  @@index([student_id])
  @@index([event_id])
}

model EventView {
  id         Int      @id @default(autoincrement())
  student_id Int
  event_id   Int
  createdAt  DateTime @default(now())

  student Student @relation(fields: [student_id], references: [student_id])
  event   Event   @relation(fields: [event_id], references: [event_id])

  @@unique([student_id, event_id])
  @@index([student_id])
}

model RSVP {
  id         Int      @id @default(autoincrement())
  student_id Int
  event_id   Int
  status     String   @default("GOING")
  createdAt  DateTime @default(now())

  student Student @relation(fields: [student_id], references: [student_id])
  event   Event   @relation(fields: [event_id], references: [event_id])

  @@unique([student_id, event_id])
}

model EventFeedback {
  id         Int      @id @default(autoincrement())
  student_id Int
  event_id   Int
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  student Student @relation(fields: [student_id], references: [student_id])
  event   Event   @relation(fields: [event_id], references: [event_id])

  @@unique([student_id, event_id])
}

model NotInterested {
  id         Int      @id @default(autoincrement())
  student_id Int
  category   String?
  tag        String?
  event_id   Int?
  createdAt  DateTime @default(now())

  student Student @relation(fields: [student_id], references: [student_id])
}

enum EventInterestStatus {
  INTERESTED
  NOT_INTERESTED
}

model EventInterest {
  id         Int                 @id @default(autoincrement())
  student_id Int
  event_id   Int
  status     EventInterestStatus
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  student Student @relation(fields: [student_id], references: [student_id])
  event   Event   @relation(fields: [event_id], references: [event_id])

  @@unique([student_id, event_id])
  @@index([event_id])
}

model EventPromotion {
  promo_id   Int     @id @default(autoincrement())
  media_type String
  media_url  String
  caption    String?

  event_id Int
  event    Event @relation(fields: [event_id], references: [event_id])
}

model PasswordResetOTP {
  id         Int      @id @default(autoincrement())
  student_id Int      @unique
  otpHash    String
  expiresAt  DateTime
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  student Student @relation(fields: [student_id], references: [student_id], onDelete: Cascade)
}

model OrganizerPasswordResetOTP {
  id        Int      @id @default(autoincrement())
  org_id    Int      @unique
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  organizer Organizer @relation(fields: [org_id], references: [org_id], onDelete: Cascade)
}

model FacultyPasswordResetOTP {
  id         Int      @id @default(autoincrement())
  faculty_id Int      @unique
  otpHash    String
  expiresAt  DateTime
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  faculty Faculty @relation(fields: [faculty_id], references: [faculty_id], onDelete: Cascade)
}

model EventEditRequest {
  edit_request_id Int      @id @default(autoincrement())
  event_id        Int
  proposedData    Json
  status          String   @default("PENDING")
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event Event @relation(fields: [event_id], references: [event_id], onDelete: Cascade)

  @@index([event_id])
  @@index([status])
}
